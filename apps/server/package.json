{
  "name": "labour-youth-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/start.js",
    "migrate": "node src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "seed": "node src/seed.ts",
    "bootstrap-admin": "node src/bootstrap-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "ajv": "8.20.0",
    "express": "5.1.0",
    "jose": "6.0.11",
    "libphonenumber-js": "1.12.9",
    "multer": "2.4.0",
    "nodemailer": "10.0.12",
    "pg": "8.16.0",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "1.4.13",
    "@types/node": "24.0.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.4",
    "typescript": "5.8.3"
  }
}
